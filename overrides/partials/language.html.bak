{% if config.extra.alternate %}
<div class="md-header__option">
  <nav class="lang-switch" aria-label="Language switcher">
    {% for alt in config.extra.alternate %}
      <a class="lang-switch__link"
         href="{{ alt.link | url }}"
         hreflang="{{ alt.lang }}">
        {{ alt.lang | upper }}
      </a>
      {% if not loop.last %}
        <span class="lang-switch__sep">|</span>
      {% endif %}
    {% endfor %}
  </nav>
</div>
{% endif %}